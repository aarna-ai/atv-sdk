DATABASE_URL=postgresql://user:pass@localhost:5432/atv_sdk
REDIS_URL=redis://localhost:6379
PORT=3000
NODE_ENV=development

# RPC URLs — one per supported chain
RPC_URL_ETHEREUM=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
RPC_URL_BASE=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY

# Strapi CMS — vault configuration source
STRAPI_URL=https://your-strapi-instance.com
# API token from Strapi Settings → API Tokens (read-only token is sufficient)
STRAPI_API_TOKEN=
# Override only if your Strapi endpoint path differs from the default
# STRAPI_VAULTS_PATH=/api/afi-vaults?populate[contracts][populate]=*
# How long to cache the vault list from Strapi (ms). Default: 5 min.
# STRAPI_CACHE_TTL_MS=300000

# Aarna engine API — source for APY, portfolio, historical NAV/TVL, and user investments
ENGINE_API_BASE_URL=https://engine.aarna.ai/api/v2
ENGINE_API_KEY=your-engine-api-key

# Vault access control is managed via the vault_allowlist table in PostgreSQL.
# Run: psql $DATABASE_URL -f apps/api/migrations/002_create_vault_allowlist.sql
# Enable a vault: UPDATE vault_allowlist SET is_allowed = TRUE WHERE product_id = 'a_fi_USDC';
