{
  "name": "@aarna/mcp-server-atv",
  "version": "1.0.0",
  "description": "MCP server connector for ATV — AI-native access to Aarna's DeFi yield vaults on Ethereum and Base",
  "keywords": [
    "mcp",
    "mcp-server",
    "defi",
    "yield",
    "usdc",
    "pendle",
    "erc-4626",
    "vault",
    "agentic",
    "fixed-income",
    "stablecoin",
    "aarna",
    "atv",
    "atv"
  ],
  "homepage": "https://github.com/aarna-ai/atv-sdk",
  "repository": {
    "type": "git",
    "url": "https://github.com/aarna-ai/atv-sdk.git",
    "directory": "packages/mcp-server"
  },
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  }
}
