{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.aarna-ai/atv",
  "description": "Access Aarna's DeFi yield vaults — query NAV/TVL/APY, build transactions, track portfolios.",
  "repository": {
    "url": "https://github.com/aarna-ai/atv-sdk",
    "source": "github"
  },
  "version": "1.0.1",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@aarna-ai/mcp-server-atv",
      "version": "1.0.1",
      "transport": {
        "type": "streamable-http",
        "url": "https://atv-api.aarna.ai/mcp"
      },
      "environmentVariables": [
        {
          "description": "API key for authenticating with the ATV API",
          "isRequired": true,
          "format": "string",
          "isSecret": true,
          "name": "ATV_API_KEY"
        }
      ]
    }
  ]
}
